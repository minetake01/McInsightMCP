{
  "name": "mcinsight-mcp-server",
  "version": "0.1.0-beta.5",
  "description": "MCP 2026-07-28 server connecting AI assistants to live Minecraft worlds via the McInsight mod",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcinsight-mcp-server": "dist/index.js",
    "mcinsight-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minetake01/McInsightMCP.git",
    "directory": "mcp-server"
  },
  "homepage": "https://github.com/minetake01/McInsightMCP#readme",
  "bugs": {
    "url": "https://github.com/minetake01/McInsightMCP/issues"
  },
  "keywords": [
    "minecraft",
    "mcp",
    "model-context-protocol",
    "neoforge",
    "fabric",
    "ai-assistant"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && npm run build",
    "typecheck": "tsc",
    "test": "vitest run",
    "e2e": "node e2e/run.mjs",
    "start:http": "node dist/index.js --http",
    "start:stdio": "node dist/index.js --stdio"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "adm-zip": "^0.6.1",
    "semver": "^7.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/semver": "^7.5.8",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
